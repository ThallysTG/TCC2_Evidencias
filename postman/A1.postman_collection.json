    {
      "name": "API2 - T2.5/T2.3 JWT (controle OK)",
      "item": [
        {
          "name": "T2.5 GET /tasks com token FORJADO (segredo errado) -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenForjado}}"
              }
            ],
            "url": {
              "raw": "https://c--0eac8a32-851b-57b1-b135-7ca4c968354f-prod.lovable.cloud/rest/v1/tasks?select=id&limit=1",
              "protocol": "https",
              "host": [
                "c--0eac8a32-851b-57b1-b135-7ca4c968354f-prod",
                "lovable",
                "cloud"
              ],
              "port": "443",
              "path": [
                "rest",
                "v1",
                "tasks"
              ],
              "query": [
                {
                  "key": "select",
                  "value": "id"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": "Token assinado com segredo errado. O JWT real é ES256 com segredo da plataforma Supabase -> 401 (não forjável)."
          },
          "response": []
        }
      ]
    }
  ]
