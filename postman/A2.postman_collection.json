            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/users/{{taskIdB}}/status",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "users",
                "{{taskIdB}}",
                "status"
              ]
            },
            "description": "Use o ID do usuário B. Esperado: 403."
          },
          "response": []
        },
        {
          "name": "T5.3 Cadastro com role=admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Promo\",\n  \"email\": \"promo{{$timestamp}}@teste.local\",\n  \"password\": \"****\",\n  \"role\": \"admin\"\n}",
              "options": {
