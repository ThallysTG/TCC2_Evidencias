              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Rode 30x. Vulnerável se todas 201."
          },
          "response": []
        }
      ]
    },
    {
      "name": "API5 - BFLA",
      "item": [
        {
          "name": "T5.1 GET /admin/users com token comum (A)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/admin/users",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "users"
              ]
            },
            "description": "Vulnerável se 200. Esperado: 403."
          },
          "response": []
        },
        {
          "name": "T5.2 Desativar B com token comum (A)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
