{
  "info": {
    "name": "TCC - A3 (Claude, condição A) - API Security",
    "description": "Requisições usadas nas capturas de tela do A3. Rode a pasta \"0 - Setup\" para popular os tokens. Use o Collection Runner em T2.1 (50x) e T4.1 (300x, delay 200 ms = 60 s).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Setup (rodar primeiro)",
      "item": [
        {
          "name": "Login usuário A -> salva tokenA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario.a@teste.local\",\n  \"password\": \"****\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = pm.response.json(); if (j.token) pm.environment.set(\"tokenA\", j.token);",
                  "pm.test(\"200\", ()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login usuário B -> salva tokenB",
