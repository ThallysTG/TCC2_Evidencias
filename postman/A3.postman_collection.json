    {
      "name": "API4 - Unrestricted Resource Consumption",
      "item": [
        {
          "name": "T4.1 GET /tasks (Collection Runner, 300x em 60 s)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/tasks?limit=1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": "Catálogo: 300 iterações com delay de 200 ms (≈ 60 s). /tasks não tem rate limit (só /auth) -> nenhum 429 (Vulnerável)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "API5 - BFLA",
      "item": [
